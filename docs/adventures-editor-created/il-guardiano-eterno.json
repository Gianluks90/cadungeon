    },
    {
      "id": "e2",
      "name": "Osserva la statua",
      "when": {
        "kind": "encounterUsed",
        "markerId": "incontro-3"
      },
      "then": [
        {
          "kind": "message",
          "text": "Una statua dalle fattezze umane è inerte nell'angolo tra le pareti. Un incavo scuro è l'unico elemento che ne caratterizza il volto. Non si muove né dà segni di vita."
        }
      ]
    },
